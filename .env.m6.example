# Matomo 6 instance - run next to the default one with: make up ENV=.env.m6

# Matomo version
# Empty = latest stable from the official image. Set e.g. 5.14.2 or 6.0.0-rc1
# to build an image with exactly that release (RCs/betas work too).
# NOTE: Matomo is copied into MATOMO_DATA_PATH on first start only. Changing the
# version later does NOT upgrade an existing instance - use a new data dir.
MATOMO_VERSION=6.0.0-rc1
MARIADB_VERSION=lts

# Port Configuration
MATOMO_PORT=8086
DB_PORT=3308

# Database Configuration
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=matomo
MYSQL_USER=matomo_user
MYSQL_PASSWORD=changeme_user_password

# Container Names
MATOMO_CONTAINER_NAME=matomo6-dev
DB_CONTAINER_NAME=matomo6-dev-db

# Network Configuration
NETWORK_NAME=matomo6_dev_network

# Volume Paths
MATOMO_DATA_PATH=./matomo6_data
DB_DATA_PATH=./db6_data

# Optional: Matomo table prefix (defaults to 'matomo_' if not set)
# MATOMO_TABLES_PREFIX=matomo_